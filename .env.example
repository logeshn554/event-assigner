# Google Gemini API Key (Server-side only)
# Get your API key from Google AI Studio: https://aistudio.google.com/
# If omitted or invalid, the app gracefully falls back to the deterministic rule-based planner.
GEMINI_API_KEY=

# Gemini Model identifier (Default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Maximum timeout for LLM requests in milliseconds (Default: 25000)
LLM_TIMEOUT_MS=25000

# Rate Limiting (Requests per minute per IP)
RATE_LIMIT_PLAN_RPM=10
RATE_LIMIT_CHAT_RPM=20

# Environment Mode
NODE_ENV=development

